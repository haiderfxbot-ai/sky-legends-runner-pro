{
  "name": "sky-legends-runner-pro",
  "version": "1.0.0",
  "description": "Sky Legends Runner - Premium Endless Runner Adventure",
  "main": "index.html",
  "scripts": {
    "start": "npx http-server -p 8080 -c-1",
    "build": "echo 'Static project - no build needed'",
    "cap:init": "npx cap init 'Sky Legends Runner' 'com.skylegends.runner' --web-dir .",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "android:build": "cd android && ./gradlew assembleDebug",
    "android:release": "cd android && ./gradlew assembleRelease",
    "android:bundle": "cd android && ./gradlew bundleRelease"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/haiderfxbot-ai/sky-legends-runner-pro.git"
  },
  "keywords": [
    "phaser",
    "game",
    "html5",
    "mobile",
    "runner",
    "android"
  ],
  "author": "haiderfxbot-ai",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^5.0.0",
    "@capacitor/cli": "^5.0.0",
    "@capacitor/core": "^5.0.0"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "typescript": "^6.0.3"
  }
}
